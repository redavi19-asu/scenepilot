{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scenepilot",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "ScenePilotRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ScenePilotRoom"]
    }
  ]
}
