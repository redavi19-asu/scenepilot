{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scenepilot",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "ScenePilotRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ScenePilotRoom"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ica-saas-db",
      "database_id": "888f63b8-f1bb-4419-b806-6b306579c632",
      "migrations_dir": "migrations"
    }
  ]
}
