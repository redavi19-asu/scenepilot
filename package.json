{
  "name": "scenepilot",
  "productName": "Urban Director Studio",
  "description": "Urban Director Studio live production director and camera platform",
  "author": "I Computer Anything",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node server/index.js\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:web": "vite --host 0.0.0.0",
    "dev:signal": "node server/index.js",
    "start:encoder": "node server/encoder.js",
    "setup:d1": "node scripts/configure-d1.mjs",
    "desktop": "electron .",
    "package:mac": "electron-builder --mac zip --arm64",
    "package:mac:dmg": "electron-builder --mac dmg zip --arm64",
    "package:win": "electron-builder --win nsis --x64",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/device": "^8.0.3",
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "hls.js": "^1.7.2",
    "lucide-react": "^1.41.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.icomputeranything.scenepilot",
    "productName": "Urban Director Studio",
    "artifactName": "Urban-Director-Studio-${version}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Urban Director Studio uses the camera for live production video.",
        "NSMicrophoneUsageDescription": "Urban Director Studio uses the microphone for live production audio."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
